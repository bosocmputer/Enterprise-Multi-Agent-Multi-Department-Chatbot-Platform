# =============================================================================
# Parts Lookup Chatbot Environment Example
# Copy to .env on local/server, then fill real secrets there only.
# ห้าม commit .env จริงที่มี token/key/password
# =============================================================================

# -----------------------------------------------------------------------------
# App / Runtime
# -----------------------------------------------------------------------------
# development | test | production. Production จะบังคับ internal auth สำหรับ endpoint ภายใน
NODE_ENV=development

# HTTP port ของ Fastify service
PORT=3060

# pino log level: silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# version ที่แสดงใน /health และ /version
APP_VERSION=0.1.0

# git sha/build id ที่แสดงใน /health เพื่อรู้ว่า container รัน version ไหน
GIT_SHA=

# public base URL ของ service ใช้กับ webhook/tunnel ภายหลัง
PUBLIC_BASE_URL=

# Bearer token สำหรับ /ready, /metrics, /internal/lookup, /internal/parse ใน production
INTERNAL_API_TOKEN=

# path ของ Business Profile/Domain Profile tenant ปัจจุบัน
BUSINESS_PROFILE_PATH=profiles/construction-demo.json

# -----------------------------------------------------------------------------
# SML MCP / Source Of Truth
# -----------------------------------------------------------------------------
# base URL ของ SML MCP read-only connector
SML_MCP_BASE_URL=http://192.168.2.248:3515

# role/access mode ที่ส่งเป็น mcp-access-mode header
SML_MCP_ACCESS_MODE=sales

# timeout ต่อ SML tool call หน่วย ms
SML_REQUEST_TIMEOUT_MS=1500

# label ของ dataset/source ที่แสดงใน reply/health
SML_DATASET_LABEL=sml-192.168.2.248

# demo | real. ถ้า demo ควรแสดงใน reply/health ให้ user รู้
SML_TENANT_STATUS=real

# เปิด circuit breaker หลัง SML fail ต่อเนื่องกี่ครั้ง
SML_CIRCUIT_FAILURE_THRESHOLD=5

# circuit breaker เปิดค้างกี่วินาทีก่อนลองใหม่
SML_CIRCUIT_OPEN_SECONDS=60

# จำนวน SML calls พร้อมกันสูงสุดต่อ process เพื่อกัน overload
SML_MAX_CONCURRENT_CALLS=10

# cache TTL สำหรับ search result หน่วยวินาที
PRODUCT_SEARCH_CACHE_TTL_SECONDS=300

# cache TTL สำหรับ stock หน่วยวินาที ควรสั้นกว่าราคาเพราะเปลี่ยนไว
STOCK_CACHE_TTL_SECONDS=30

# cache TTL สำหรับ price หน่วยวินาที
PRICE_CACHE_TTL_SECONDS=300

# negative/refinement cache TTL สำหรับ query ที่กว้าง/ไม่ชัด เพื่อลดการยิงซ้ำถี่
REFINEMENT_CACHE_TTL_SECONDS=60

# off | warn | enforce. enforce จะไม่โชว์ผลค้นที่ relevance ต่ำ
RESULT_QUALITY_MODE=enforce

# โชว์ suggested MCP name ใน capability gap reply หรือไม่
CAPABILITY_GAP_SHOW_TECHNICAL_HINT=false

# -----------------------------------------------------------------------------
# Internal Endpoints / Metrics
# -----------------------------------------------------------------------------
# เปิด /internal/lookup และ /internal/parse สำหรับ smoke/debug
LOOKUP_TEST_ENDPOINT_ENABLED=true

# เปิด /metrics Prometheus-style endpoint
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Redis / Rate Limit / Context
# -----------------------------------------------------------------------------
# Redis URL. ว่าง = ใช้ memory store สำหรับ local เท่านั้น
REDIS_URL=

# rate limit ต่อ user/chat ต่อนาที
RATE_LIMIT_PER_MINUTE=20

# context ล่าสุด เช่น เลือกรายการแล้วถามต่อว่า "ราคา" เก็บกี่วินาที
TELEGRAM_CONTEXT_TTL_SECONDS=300

# dedup Telegram update เก็บกี่วินาทีเพื่อกันตอบซ้ำ
TELEGRAM_DEDUP_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Dev/Ops Alerts
# -----------------------------------------------------------------------------
# เปิดแจ้งเตือน dev/ops ผ่าน Telegram alert bot
ALERTS_ENABLED=false

# token ของ alert bot แยกจาก staff-facing bot ถ้ามี
ALERT_TELEGRAM_BOT_TOKEN=

# chat id ของ dev/ops ที่รับ alert
OPS_TELEGRAM_CHAT_ID=

# dedup alert กี่วินาที เพื่อไม่ให้แจ้งเตือนรัวเรื่องเดิม
ALERT_DEDUP_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# QA Trace / Staff Pilot Logging
# -----------------------------------------------------------------------------
# เปิด QA trace สำหรับช่วง staff test เพื่อเก็บ decision trace เพิ่มเติม
QA_TRACE_ENABLED=false

# เก็บ raw user text หรือไม่. เปิดเฉพาะ staff pilot ที่ยอมรับเรื่อง privacy แล้ว
QA_TRACE_INCLUDE_RAW_TEXT=false

# เก็บ raw bot reply หรือไม่. ช่วยดู UX/copy แต่ควรเปิดเฉพาะ pilot
QA_TRACE_INCLUDE_BOT_REPLY=false

# ตัด raw text/reply ยาวเกินกี่ตัวอักษร เพื่อลด log ใหญ่เกินไป
QA_TRACE_MAX_TEXT_CHARS=1000

# redact token/key/password และเลขที่มากับ label เช่น phone/account ก่อนเขียน QA trace
QA_TRACE_REDACT_SECRETS=true

# sample rate 0-1. 1 = เก็บทุกข้อความที่เข้า QA trace, 0.1 = ประมาณ 10%
QA_TRACE_SAMPLE_RATE=1

# retention เป้าหมายของ QA trace หน่วยวัน. ตัวแอปใส่ใน log metadata; log rotation ต้องตั้งที่ infra/server
QA_TRACE_TTL_DAYS=14

# -----------------------------------------------------------------------------
# Assist UX / Batch Handling
# -----------------------------------------------------------------------------
# ให้ final reply ใส่ footer ว่า LiteLLM ช่วยตีความ แต่ข้อมูลจริงมาจากระบบต้นทาง
ASSIST_RESULT_FOOTER_ENABLED=true

# ให้ user เห็น status ระหว่างเข้า LiteLLM assist slow path
ASSIST_USER_STATUS_ENABLED=true

# โชว์ชื่อ provider/model ใน assist status/footer
ASSIST_USER_STATUS_SHOW_MODEL=true

# ถ้า LLM ตอบเร็วกว่า delay นี้ จะไม่ส่ง status เพื่อลด noise
ASSIST_STATUS_MIN_DELAY_MS=800

# เปิดข้อความหลายบรรทัดแบบ bounded batch
BATCH_LOOKUP_ENABLED=true

# จำนวนคำถามย่อยสูงสุดใน 1 batch message
MAX_BATCH_ITEMS=5

# ความยาวข้อความ batch สูงสุด
MAX_BATCH_TEXT_CHARS=1200

# -----------------------------------------------------------------------------
# LINE Channel
# -----------------------------------------------------------------------------
# เปิด LINE webhook adapter
LINE_ENABLED=false

# LINE channel secret สำหรับ verify raw-body signature
LINE_CHANNEL_SECRET=

# LINE channel access token สำหรับ reply/loading animation
LINE_CHANNEL_ACCESS_TOKEN=

# prefix ที่ยอมให้ใช้ใน LINE group/room เช่น /stock
LINE_GROUP_PREFIXES=/,!

# -----------------------------------------------------------------------------
# LiteLLM / LLM Parser
# -----------------------------------------------------------------------------
# เปิด parser ง่าย ๆ; ถ้า true และ mode=off ระบบจะ derive เป็น shadow
LLM_PARSER_ENABLED=false

# off | shadow | assist. assist ใช้ LLM parse เพื่อ retry query ที่ no-match/unsupported
LLM_PARSER_MODE=off

# litellm | openai. ตอนนี้ pilot ใช้ litellm ผ่าน OpenAI-compatible endpoint
LLM_PROVIDER=litellm

# LiteLLM base URL
LITELLM_BASE_URL=http://192.168.2.248:4000

# LiteLLM virtual key. ห้ามใส่ใน repo/chat; ใส่เฉพาะ .env จริง
LITELLM_API_KEY=

# LiteLLM router/model name. ถ้าให้ LiteLLM เลือก provider เอง ต้องตั้งเป็น router alias
LITELLM_MODEL=parts-lookup-parser-auto-2

# fallback key ถ้า provider=openai หรือใช้ OpenAI-compatible key ผ่าน env เดิม
OPENAI_API_KEY=

# optional OpenAI-compatible base URL
OPENAI_BASE_URL=

# timeout LLM parser หน่วย ms. Staff pilot อาจตั้งสูงเพื่อเห็น latency model จริง
LLM_PARSER_TIMEOUT_MS=6000

# confidence ต่ำกว่านี้จะ reject แล้ว fallback ปลอดภัย
LLM_MIN_CONFIDENCE=0.75

# จำกัด LLM calls พร้อมกัน เพื่อไม่ให้ polling backlog จาก model ช้า
LLM_MAX_CONCURRENT_CALLS=2

# รอ queue LLM assist ได้กี่ ms ก่อน fallback
LLM_ASSIST_QUEUE_WAIT_MS=5000

# -----------------------------------------------------------------------------
# Telegram Channel
# -----------------------------------------------------------------------------
# เปิด Telegram adapter โดยรวม
TELEGRAM_ENABLED=false

# เปิด polling mode. เหมาะกับ pilot เพราะไม่ต้องมี public webhook
TELEGRAM_POLLING_ENABLED=false

# เปิด Telegram webhook mode ถ้ามี public ingress
TELEGRAM_WEBHOOK_ENABLED=false

# polling interval ระหว่างรอบ getUpdates หน่วย ms
TELEGRAM_POLLING_INTERVAL_MS=1000

# long polling timeout หน่วยวินาที
TELEGRAM_POLLING_TIMEOUT_SECONDS=25

# staff-facing Telegram bot token. ห้าม commit
TELEGRAM_BOT_TOKEN=

# secret สำหรับ Telegram webhook header
TELEGRAM_WEBHOOK_SECRET=

# username bot ใช้ช่วยตรวจ mention/reply ใน group
TELEGRAM_BOT_USERNAME=

# -----------------------------------------------------------------------------
# Public Ingress / LINE Webhook Later
# -----------------------------------------------------------------------------
# Cloudflare tunnel token สำหรับ expose webhook เฉพาะ service นี้
CLOUDFLARE_TUNNEL_TOKEN=

# hostname/subdomain ของ tunnel
CLOUDFLARE_TUNNEL_HOSTNAME=
